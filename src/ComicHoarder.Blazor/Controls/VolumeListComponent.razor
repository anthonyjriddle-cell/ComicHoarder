@inject IViewVolumesByPublisherAndNameUseCase ViewVolumesByPublisherAndNameUseCase
@inject IDeleteVolumeUseCase DeleteVolumeUseCase

@if (volumes == null)
{
    <br />
    <div class="spinner-border" role="status">
        <span class="sr-only"></span>
    </div>
    <div class="">Loading...</div>
}
else
{
    <QuickGrid Items="volumes.AsQueryable()" Pagination="pagination" class="table">
        <PropertyColumn Property="v => v.Name" Sortable="true" />
        <PropertyColumn Property="v => v.Id" Sortable="true" />
        <PropertyColumn Property="v => v.DescriptionNoHtml" Title="Description" Sortable="true" Class="wrap-long-text" />
        <PropertyColumn Property="v => v.Collectable" Sortable="true" />
        <PropertyColumn Property="v => v.Enabled" Sortable="true" />
        <PropertyColumn Property="v => v.DateLastUpdated" Title="Date Last Updated" Sortable="true" />
        <TemplateColumn Title="ComicVine" Sortable="false">
            <a href="https://comicvine.gamespot.com/volume/4050-@(context.Id)/" target="_blank" rel="noopener noreferrer">ComicVine</a>
        </TemplateColumn>
        <TemplateColumn Sortable="false" Class="narrow-col">
            <a href="/issues/@context.Id" class="btn btn-success">Issues</a>
        </TemplateColumn>
        <TemplateColumn Sortable="false" Class="narrow-col">
            <a href="/editvolume/@context.Id" class="btn btn-primary">Edit</a>
        </TemplateColumn>
        <TemplateColumn Sortable="false" Class="narrow-col">
            <button type="button" class="btn btn-danger" @onclick="async () => await HandleDelete(context)">Delete</button>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
}

@if (ShowConfirmation)
{
    <DeleteConfirmationDialogComponent ConfirmationChanged="ConfirmDelete_Click" @ref="DeleteConfirmation"></DeleteConfirmationDialogComponent>
}

@code {
    [Parameter]
    public string? SearchVolumeFilter { get; set; }
    [Parameter]
    public int PublisherId { get; set; }
    private List<Volume>? volumes;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 25 };
    protected DeleteConfirmationDialogComponent DeleteConfirmation { get; set; }
    private bool ShowConfirmation = false;
    private Volume? volumeToDelete;

    protected override async Task OnParametersSetAsync()
    {
        volumes = (await ViewVolumesByPublisherAndNameUseCase.ExecuteAsync(PublisherId, SearchVolumeFilter ?? string.Empty)).ToList();
    }

    private async Task HandleDelete(Volume volume)
    {
        volumeToDelete = volume;
        ShowConfirmation = true;
        DeleteConfirmation.Show();
    }

    protected async Task ConfirmDelete_Click(bool deleteConfirmed)
    {
        if (deleteConfirmed && volumeToDelete != null)
        {
            await DeleteVolumeUseCase.ExecuteAsync(volumeToDelete.Id);
            volumes?.Remove(volumeToDelete);
        }
        ShowConfirmation = false;
        volumeToDelete = null;
    }
}