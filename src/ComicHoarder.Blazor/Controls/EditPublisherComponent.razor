@inject IEditPublisherUseCase EditPublisherUseCase
@inject NavigationManager NavigationManager

@if (publisher != null)
{
    <div class="card shadow-sm">
        <div class="card-header">
            <h3 class="mb-0">Edit Publisher</h3>
        </div>

        <div class="card-body">

            <EditForm Model="publisher" OnValidSubmit="Update">
                <DataAnnotationsValidator />
                <ValidationSummary class="mb-3" />

                <div class="row g-3">

                    <!-- ================= LEFT: COMIC COVER ================= -->
                    <div class="col-md-3">

                        <div class="d-flex justify-content-center">
                            <div class="border rounded d-flex align-items-center justify-content-center text-muted"
                                 style="width:210px; height:320px;">
                                Comic Cover
                            </div>
                        </div>

                    </div>

                    <!-- ================= RIGHT: FORM ================= -->
                    <div class="col-md-9">

                        <div class="row g-3">

                            <!-- Publisher Name -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Publisher Name</label>

                                <InputText @bind-Value="publisher.Name"
                                           class="form-control" />

                                <ValidationMessage For="() => publisher.Name" />
                            </div>

                            <!-- Date Last Updated -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Date Last Updated</label>

                                <input value="@publisher.DateLastUpdated?.ToString("g")" class="form-control" disabled />

                                <ValidationMessage For="() => publisher.DateLastUpdated" />
                            </div>

                            <!-- Publisher Id -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Publisher Id</label>

                                <input value="@publisher.Id"
                                       class="form-control"
                                       disabled />
                            </div>

                            <!-- Enabled -->
                            <div class="col-md-6 d-flex align-items-end">

                                <div class="form-check">
                                    <InputCheckbox id="enabled"
                                                   @bind-Value="publisher.Enabled"
                                                   class="form-check-input" />

                                    <label class="form-check-label" for="enabled">
                                        Enabled
                                    </label>
                                </div>

                                <ValidationMessage For="() => publisher.Enabled" />
                            </div>

                            <!-- Description -->
                            <div class="col-12">
                                <label class="form-label fw-semibold">Description</label>

                                <InputTextArea @bind-Value="publisher.Description"
                                               rows="6"
                                               class="form-control" />

                                <ValidationMessage For="() => publisher.Description" />
                            </div>

                        </div>
                    </div>

                    <!-- ================= ACTION BUTTONS (FULL WIDTH ROW) ================= -->
                    <div class="col-12 mt-3">
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Update
                            </button>

                            <a href="/Publishers"
                               class="btn btn-primary">
                                Cancel
                            </a>

                        </div>
                    </div>

                    <!-- ================= COMICVINE CARD ================= -->
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                ComicVine
                            </div>

                            <div class="card-body">

                                <p class="text-muted mb-3">
                                    ComicVine metadata integration and synchronization.
                                </p>

                                <button type="button"
                                        class="btn btn-success">
                                    Fetch ComicVine
                                </button>

                            </div>
                        </div>
                    </div>

                </div>
            </EditForm>

        </div>
    </div>
}

@code {
    [Parameter]
    public Publisher? publisher { get; set; }

    [SupplyParameterFromForm]
    public Publisher? outPublisher { get; set; }

    [Parameter]
    public EventCallback<Publisher?> OnUpdate { get; set; }

    private void Update()
    {
         OnUpdate.InvokeAsync(publisher);
    }

}
