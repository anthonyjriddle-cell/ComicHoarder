@inject NavigationManager NavigationManager

@inject IAddPublisherUseCase AddPublisherUseCase

@if (Publisher != null)
{
    <tr>
        <td>@Publisher.Id</td>
        <td>@Publisher.Name</td>
        <td>@Publisher.Description</td>
        <td>@Publisher.Enabled</td>
        <td>@Publisher.DateLastUpdated</td>
        <td>
            <button type="button" class="btn btn-primary" style="width:200px;" @onclick="async () => await HandleAddPublisher(Publisher.Id)">Add Publisher</button>
        </td>
    </tr>
}

@code {
    [Parameter]
    public Publisher? Publisher { get; set; }



    private async Task HandleAddPublisher(int publisherId)
    {
        await AddPublisherUseCase.ExecuteAsync(Publisher);
        this.Publisher = null;
        NavigationManager.NavigateTo(@"\Publishers");
    }
}
