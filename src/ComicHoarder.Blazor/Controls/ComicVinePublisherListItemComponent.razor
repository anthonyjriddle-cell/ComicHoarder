@inject NavigationManager NavigationManager

@inject IAddPublisherUseCase AddPublisherUseCase

@if (Publisher != null)
{
    <tr>
        <td>@Publisher.Id</td>
        <td>@Publisher.Name</td>
        <td>@Publisher.Description</td>
        <td>@Publisher.Enabled</td>
        <td>@Publisher.DateLastUpdated</td>
        <td><a href="https://comicvine.gamespot.com/publisher/4010-@(Publisher.Id)/" target="_blank" rel="noopener noreferrer">ComicVine</a></td>
        <td>
            <button type="button" class="btn btn-primary" style="width:200px;" @onclick="async () => await HandleAddPublisher(Publisher)">Add Publisher</button>
        </td>
    </tr>
}

@code {
    [Parameter]
    public Publisher? Publisher { get; set; }



    private async Task HandleAddPublisher(Publisher publisher)
    {
        await AddPublisherUseCase.ExecuteAsync(publisher);
        Publisher = null;
        NavigationManager.NavigateTo("/Publishers");
    }
}
