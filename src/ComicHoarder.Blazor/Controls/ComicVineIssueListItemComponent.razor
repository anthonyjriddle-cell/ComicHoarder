@inject NavigationManager NavigationManager
@inject IAddIssueUseCase AddIssueUseCase

@if (Issue != null)
{
    <tr>
        <td>@Issue.Id</td>
        <td>@Issue.IssueNumber</td>
        <td>@Issue.Name</td>
        <td>@Issue.Summary</td>
        <td>@Issue.Enabled</td>
        <td><a href="https://comicvine.gamespot.com/volume/4000-@(Issue.Id)/" target="_blank" rel="noopener noreferrer">ComicVine</a></td>
        <td>
            <button type="button"
                    class="btn btn-primary"
                    style="width:200px;"
                    @onclick="async () => await HandleAddIssue(Issue)">
                Add Issue
            </button>
        </td>
    </tr>
}

@code {
    [Parameter]
    public Issue? Issue { get; set; }

    [Parameter]
    public int VolumeId { get; set; }

    private async Task HandleAddIssue(Issue issue)
    {
        await AddIssueUseCase.ExecuteAsync(issue);

        Issue = null;

        NavigationManager.NavigateTo($"/Issues/{VolumeId}");
    }
}
