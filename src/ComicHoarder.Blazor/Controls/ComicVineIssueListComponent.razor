@inject ISearchMissingComicVineIssuesByVolumeUseCase SearchMissingComicVineIssuesByVolumeUseCase

@if (Searching)
{
    <br />
    <div class="spinner-border" role="status">
        <span class="sr-only"></span>
    </div>
    <div class="">Loading from ComicVine...</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Issue Number</th>
                <th>Name</th>
                <th>Summary</th>
                <th>Enabled</th>
                <th>ComicVine Link</th>
                <th style="text-align: left"></th>
            </tr>
        </thead>
        <tbody>
            @if (Issues != null && Issues.Count > 0)
            {
                foreach (var issue in Issues)
                {
                    <ComicVineIssueListItemComponent Issue="issue"
                                                     VolumeId="VolumeId">
                    </ComicVineIssueListItemComponent>
                }
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public int VolumeId { get; set; }

    public bool Searching { get; set; }

    public List<Issue>? Issues { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Searching = true;
        await InvokeAsync(StateHasChanged);

        Issues = (await SearchMissingComicVineIssuesByVolumeUseCase
            .ExecuteAsync(VolumeId))
            .ToList();

        Searching = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task Refresh()
    {
        await InvokeAsync(StateHasChanged);
    }
}
