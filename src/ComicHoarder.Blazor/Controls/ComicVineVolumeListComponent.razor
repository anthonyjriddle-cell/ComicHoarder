@inject ISearchMissingComicVineVolumesByPublisherUseCase SearchMissingComicVineVolumesByPublisherUseCase

@if (Searching)
{
    <br />
    <div class="spinner-border" role="status">
        <span class="sr-only"></span>
    </div>
    <div class="">Loading from ComicVine...</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Enabled</th>
                <th>ComicVine Link</th>
                <th style="text-align: left"></th>
            </tr>
        </thead>
        <tbody>
            @if (Volumes != null && Volumes.Count > 0)
            {
                foreach (var volume in Volumes)
                {
                    <ComicVineVolumeListItemComponent Volume="volume"
                                                      PublisherId="PublisherId">
                    </ComicVineVolumeListItemComponent>
                }
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public int PublisherId { get; set; }

    public bool Searching { get; set; }

    public List<Volume>? Volumes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Searching = true;
        await InvokeAsync(StateHasChanged);

        Volumes = (await SearchMissingComicVineVolumesByPublisherUseCase
            .ExecuteAsync(PublisherId))
            .ToList();

        Searching = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task Refresh()
    {
        await InvokeAsync(StateHasChanged);
    }
}
