@inject NavigationManager NavigationManager
@inject IDeletePublisherUseCase DeletePublisherUseCase

@if (Publisher != null)
{
    <tr>
        <td>@Publisher.Name</td>
        <td>@Publisher.Id</td>
        <td>@Publisher.Description</td>
        <td>@Publisher.Enabled</td>
        <td>@Publisher.DateLastUpdated</td>
        <td><a href="/volumes/@Publisher.Id" class="btn btn-success">Volumes</a></td>
        <td>
            <a href="/editpublisher/@Publisher.Id" class="btn btn-primary">Edit</a>
        </td>
        <td>
            <button type="button" class="btn btn-danger" @onclick="async () => await HandleDelete(Publisher.Id)">Delete</button>
        </td>
    </tr>
}
<DeleteConfirmationDialogComponent ConfirmationChanged="ConfirmDelete_Click" @ref="DeleteConfirmation"></DeleteConfirmationDialogComponent>

@code {
    [Parameter]
    public Publisher? Publisher { get; set; }

    protected DeleteConfirmationDialogComponent DeleteConfirmation { get; set; }

    private async Task HandleDelete(int publisherId)
    {
        DeleteConfirmation.Show();
    }

    protected async Task ConfirmDelete_Click(bool deleteConfirmed)
    {
        if (deleteConfirmed)
        {
            await DeletePublisherUseCase.ExecuteAsync(Publisher.Id);
            this.Publisher = null;
        }
    }
}
