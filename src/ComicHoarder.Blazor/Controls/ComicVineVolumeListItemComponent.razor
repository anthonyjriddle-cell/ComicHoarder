@inject NavigationManager NavigationManager
@inject IAddVolumeUseCase AddVolumeUseCase

@if (Volume != null)
{
    <tr>
        <td>@Volume.Id</td>
        <td>@Volume.Name</td>
        <td>@Volume.Description</td>
        <td>@Volume.Collectable</td>
        <td>@Volume.Enabled</td>
        <td>@Volume.DateLastUpdated</td>
        <td>
            <button type="button"
                    class="btn btn-primary"
                    style="width:200px;"
                    @onclick="async () => await HandleAddVolume(Volume)">
                Add Volume
            </button>
        </td>
    </tr>
}

@code {
    [Parameter]
    public Volume? Volume { get; set; }

    [Parameter]
    public int PublisherId { get; set; } 

    private async Task HandleAddVolume(Volume volume)
    {
        await AddVolumeUseCase.ExecuteAsync(volume);
        Volume = null;
        NavigationManager.NavigateTo($"/Volumes/{PublisherId}");
    }
}