@inject NavigationManager NavigationManager
@inject IDeleteVolumeUseCase DeleteVolumeUseCase

@if (Volume != null)
{
    <tr>
        <td>@Volume.Name</td>
        <td>@Volume.DescriptionNoHtml</td>
        <td>@Volume.Collectable</td>
        <td>@Volume.Enabled</td>
        <td>@Volume.DateLastUpdated</td>
        <td><a href="/issues/@Volume.Id" class="btn btn-success">Issues</a></td>
        <td>
            <a href="/editvolume/@Volume.Id" class="btn btn-primary">Edit</a>
        </td>
        <td>
            <button type="button" class="btn btn-danger" @onclick="async () => await HandleDelete(Volume.Id)">Delete</button>
        </td>
    </tr>
}
<DeleteConfirmationDialogComponent ConfirmationChanged="ConfirmDelete_Click" @ref="DeleteConfirmation"></DeleteConfirmationDialogComponent>

@code {
    [Parameter]
    public Volume? Volume { get; set; }

    protected DeleteConfirmationDialogComponent DeleteConfirmation { get; set; }

    private async Task HandleDelete(int volumeId)
    {
        DeleteConfirmation.Show();
    }

    protected async Task ConfirmDelete_Click(bool deleteConfirmed)
    {
        if (deleteConfirmed)
        {
            await DeleteVolumeUseCase.ExecuteAsync(Volume.Id);
            this.Volume = null;
        }
    }
}
