@page "/Volumes/{pubId:int}"

<div class="row">
    <div class="col-auto"><h3>Volume List</h3></div>
    <div class="col-auto ms-auto"><a href="/AddVolume" class="btn btn-primary">Add Volume</a></div>
</div>

<br />
<br />

<br />
<SearchComponent OnSearch="HandleSearch"></SearchComponent>
<VolumeListComponent SearchVolumeFilter="@SearchFilter" PublisherId="@pubId"></VolumeListComponent>
<br />
<br />

@code {
    [Parameter]
    public int pubId { get; set; }

    private string? SearchFilter { get; set; }

    private void HandleSearch(string SearchFilter)
    {
        this.SearchFilter = SearchFilter;
    }
}
